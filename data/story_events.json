    "title": "王獣の証",
    "spoilerTier": "major",
    "participants": [
      "ミレナ"
    ],
    "lines": [
      {
        "speaker": "ミレナ",
        "text": "力だけじゃない。ここまで育ててきた全部を見られていた気がする。"
      }
    ],
    "setsFlags": [
      "secret_beast_cleared"
    ]
  },
  {
    "id": "EV024",
    "chapter": 9,
    "areaId": "primordial_garden",
    "trigger": "postgame_final_defeated",
    "title": "調律師の証",
    "spoilerTier": "major",
    "participants": [
      "ミレナ",
      "ガルド"
    ],
    "lines": [
      {
        "speaker": "ガルド",
        "text": "図鑑の数だけ出会いがあり、配合の数だけ旅が続いた。もう立派な調律師じゃ。"
      },
      {
        "speaker": "ミレナ",
        "text": "ううん。まだ全部は見てない。だから、もう少しだけ旅してくる。"
      }
    ],
    "setsFlags": [
      "postgame_complete"
    ]
  },
