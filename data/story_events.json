    "title": "原初庭園",
    "spoilerTier": "major",
    "participants": [
      "ミレナ",
      "エルノ"
    ],
    "lines": [
      {
        "speaker": "エルノ",
        "text": "古い記録では、ここは最初の調律師が魔物と暮らした場所らしい。"
      },
      {
        "speaker": "ミレナ",
        "text": "だったら、まだ見たことのない配合の答えもありそうだね。"
      }
    ],
    "setsFlags": [
      "ss_synthesis_unlocked"
    ]
  },
  {
    "id": "EV023",
    "chapter": 9,
    "areaId": "primordial_garden",
